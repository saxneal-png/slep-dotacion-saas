rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES AUXILIARES DE AUTORIZACIÓN (RBAC & MULTITENANCY) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Permite al Administrador Oficial o cuenta de soporte gestionar todas las tablas
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'saxneal@gmail.com' ||
        request.auth.token.email.matches('.*@eduvallediguillin[.]gob[.]cl') ||
        request.auth.token.email.matches('.*@slepvallediguillin[.]cl')
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && getUserData().activo == true)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isActiveUser() && (
          getUserData().rol == 'admin' ||
          getUserData().rol == 'super_usuario' ||
          getUserData().rol == 'subdirector_uatp'
        )
      );
    }

    function isAuditor() {
      return isSuperAdmin() || (
        isActiveUser() && (
          getUserData().rol == 'auditor' ||
          getUserData().rol == 'subdirector_uatp'
        )
      );
    }

    function canReadRbd(rbd) {
      return isSuperAdmin() || (
        isActiveUser() && (
          getUserData().rol == 'admin' ||
          getUserData().rol == 'super_usuario' ||
          getUserData().rol == 'subdirector_uatp' ||
          getUserData().rol == 'coordinador_uatp' ||
          getUserData().rol == 'auditor' ||
          ((getUserData().rol == 'asesor' || getUserData().rol == 'asesor_uatp') && ('carteraRbds' in getUserData()) && rbd in getUserData().carteraRbds) ||
          ((getUserData().rol == 'director_colegio' || getUserData().rol == 'director_establecimiento' || getUserData().rol == 'jefe_utp_establecimiento') && getUserData().rbdAsignado == rbd)
        )
      );
    }

    function canWriteRbd(rbd) {
      return isSuperAdmin() || (
        isActiveUser() && (
          getUserData().rol == 'admin' ||
          getUserData().rol == 'super_usuario' ||
          getUserData().rol == 'subdirector_uatp' ||
          getUserData().rol == 'coordinador_uatp' ||
          ((getUserData().rol == 'asesor' || getUserData().rol == 'asesor_uatp') && ('carteraRbds' in getUserData()) && rbd in getUserData().carteraRbds) ||
          ((getUserData().rol == 'director_colegio' || getUserData().rol == 'director_establecimiento' || getUserData().rol == 'jefe_utp_establecimiento') && getUserData().rbdAsignado == rbd)
        )
      );
    }

    // Validación de integridad normativa Ley 20.903 (tope de 44 hrs cronológicas semanales)
    function isValidDocentePayload(data) {
      return data.horasContrato is number &&
             data.horasContrato >= 0 &&
             data.horasContrato <= 44 &&
             data.rbd is string;
    }

    // 1. PERFILES DE USUARIO (Solo usuarios autenticados consultan perfiles; escritura controlada por RBAC)
    match /usuarios/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 1.b MATRIZ DE ROLES Y AUDITORÍA DE PERMISOS RBAC
    match /config_roles/{rolId} {
      allow read: if true;
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /auditoria_permisos/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 2. ESTABLECIMIENTOS (Aislamiento territorial: Director solo su RBD, Asesor su cartera, Admin/Auditor todo)
    match /establecimientos/{rbd} {
      allow read: if true;
      allow write: if true;
    }

    // 3. CURSOS SAE
    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. DOCENTES (Protección de PII + Validación de límite normativo 44 hrs Ley 20.903)
    match /docentes/{docenteId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. ASIGNACIONES CURRICULARES LEY 20.903
    match /asignaciones/{asigId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. ASISTENTES DE LA EDUCACIÓN
    match /asistentes/{asistenteId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. BLOQUEOS DE EDICIÓN CONCURRENTE
    match /bloqueos_edicion/{rbd} {
      allow read: if true;
      allow write: if true;
    }

    // 8. SALAS Y ESPACIOS
    match /salas/{salaId} {
      allow read: if true;
      allow write: if true;
    }

    // Regla de Salvaguarda Zero Trust: Denegar cualquier otra colección no explicitada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
